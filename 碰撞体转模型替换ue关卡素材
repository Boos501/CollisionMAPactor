# ================================================================
#  [v11 新增] 获取编辑器世界（优先 UnrealEditorSubsystem，回退 EditorLevelLibrary）
# ================================================================
def _get_editor_world():
    """优先使用 UnrealEditorSubsystem.get_editor_world()（UE 5.5+），
    若不可用则回退到 EditorLevelLibrary.get_editor_world()。"""
    ues_cls = getattr(unreal, 'UnrealEditorSubsystem', None)
    if ues_cls is not None:
        try:
            return unreal.get_editor_subsystem(ues_cls).get_editor_world()
        except Exception:
            pass
    ell = getattr(unreal, 'EditorLevelLibrary', None)
    if ell is not None:
        try:
            return ell.get_editor_world()
        except Exception:
            pass
    unreal.log_error("  [v11] 无法获取编辑器世界，UnrealEditorSubsystem 和 EditorLevelLibrary 均不可用")
    return None

# ================================================================
#  [v11 新增] Actor 去重辅助函数
# ================================================================
def _unique_actors(actor_component_pairs):
    """从 (actor, component) 列表中提取唯一 Actor，优先用对象本身作哈希键，
    回退到 id() 以兼容不可哈希的情况。"""
    try:
        return list({actor: None for actor, _comp in actor_component_pairs}.keys())
    except TypeError:
        seen = {}
        for actor, _comp in actor_component_pairs:
            seen[id(actor)] = actor
        return list(seen.values())

# ================================================================
#  [v11 新增] 合并导出所有被替换 Actor 为单个 FBX 或 OBJ 文件
# ================================================================
def export_merged_convex(replaced_actor_components, fmt):
    """[v11 新增] 将所有被替换为 _Convex 简模的 Actor 合并导出到单个 FBX/OBJ 文件。
    使用 LevelExporterFBX/LevelExporterOBJ 以保留各 Actor 的世界 Transform。"""
    if not replaced_actor_components:
        unreal.log_warning("  [v11] 无已替换的 Actor，跳过合并导出")
        return

    fmt_lower = fmt.lower()
    if fmt_lower == "fbx":
        exporter_cls = getattr(unreal, 'LevelExporterFBX', None)
    elif fmt_lower == "obj":
        exporter_cls = getattr(unreal, 'LevelExporterOBJ', None)
    else:
        unreal.log_warning(f"  [v11] 不支持的合并导出格式: {fmt}，请使用 fbx 或 obj")
        return

    if exporter_cls is None:
        unreal.log_error(f"  [v11] unreal.{('LevelExporterFBX' if fmt_lower == 'fbx' else 'LevelExporterOBJ')} 不可用，跳过合并导出")
        return

    world = _get_editor_world()
    if world is None:
        return

    export_dir = EXPORT_MESH_DIR if EXPORT_MESH_DIR else TEMP_DIR
    os.makedirs(export_dir, exist_ok=True)
    export_path = os.path.join(export_dir, f"{EXPORT_MERGED_NAME}.{fmt_lower}")

    # 提取唯一 Actor 列表
    actors_to_export = _unique_actors(replaced_actor_components)

    # 保存当前选中集合，导出后还原
    editor_actor_sub = unreal.get_editor_subsystem(unreal.EditorActorSubsystem)
    prev_selected = list(editor_actor_sub.get_selected_level_actors())
    try:
        editor_actor_sub.set_selected_level_actors(actors_to_export)

        task = unreal.AssetExportTask()
        task.set_editor_property("object", world)
        task.set_editor_property("filename", export_path)
        task.set_editor_property("automated", True)
        task.set_editor_property("prompt", False)
        task.set_editor_property("replace_identical", True)
        task.set_editor_property("selected", True)
        task.set_editor_property("exporter", exporter_cls())

        if fmt_lower == "fbx":
            options = unreal.FbxExportOption()
            options.set_editor_property("ascii", False)
            options.set_editor_property("collision", False)
            options.set_editor_property("level_of_detail", False)
            task.set_editor_property("options", options)

        ok = unreal.Exporter.run_asset_export_task(task)
        if ok and os.path.exists(export_path):
            size_kb = os.path.getsize(export_path) / 1024
            unreal.log(
                f"  [v11] 合并导出成功 ({fmt.upper()})，共 {len(actors_to_export)} 个 Actor，"
                f"包含世界 Transform: {export_path} ({size_kb:.1f} KB)"
            )
        else:
            unreal.log_error(f"  [v11] 合并导出失败 ({fmt.upper()}): {export_path}")
    finally:
        editor_actor_sub.set_selected_level_actors(prev_selected)

# ================================================================
#  [v11 新增] 合并导出所有被替换 Actor 为单个 ABC 文件
# ================================================================
def export_merged_convex_abc(replaced_actor_components):
    """[v11 新增] 将所有被替换为 _Convex 简模的 Actor 合并导出到单个 ABC 文件。
    按优先级探测可用的 Alembic Exporter 类：AlembicExporter → 任何含 Alembic 的 Exporter 子类。
    若均不可用则给出明确的手动导出指引，不再静默失败。"""
    if not replaced_actor_components:
        unreal.log_warning("  [v11] 无已替换的 Actor，跳过 ABC 合并导出")
        return

    # 1. 优先探测 unreal.AlembicExporter
    exporter_cls = getattr(unreal, 'AlembicExporter', None)

    # 2. 若不存在，扫描 dir(unreal) 中所有名称含 Alembic 且是 unreal.Exporter 子类的类
    if exporter_cls is None:
        for attr_name in dir(unreal):
            if 'alembic' not in attr_name.lower():
                continue
            cls = getattr(unreal, attr_name, None)
            if cls is None:
                continue
            try:
                if isinstance(cls, type) and issubclass(cls, unreal.Exporter):
                    exporter_cls = cls
                    unreal.log(f"  [v11] 探测到 Alembic Exporter: unreal.{attr_name}")
                    break
            except TypeError:
                # issubclass 对非类型对象会抛 TypeError，安全跳过
                continue

    if exporter_cls is None:
        unreal.log_warning(
            "  [v11] UE 5.5 默认 Python API 未暴露 Alembic Exporter 类，无法自动导出 ABC。\n"
            "  建议：\n"
            "    1. 在 UE 编辑器中选中所有 _Convex Actor → File → Export Selected... → 选择 .abc 格式手动导出；\n"
            "    2. 或在 插件管理器 中启用 'AlembicImporter' 插件后重启编辑器再试。"
        )
        return

    world = _get_editor_world()
    if world is None:
        return

    export_dir = EXPORT_ABC_DIR if EXPORT_ABC_DIR else TEMP_DIR
    os.makedirs(export_dir, exist_ok=True)
    export_path = os.path.join(export_dir, f"{EXPORT_MERGED_NAME}.abc")

    actors_to_export = _unique_actors(replaced_actor_components)

    editor_actor_sub = unreal.get_editor_subsystem(unreal.EditorActorSubsystem)
    prev_selected = list(editor_actor_sub.get_selected_level_actors())
    try:
        editor_actor_sub.set_selected_level_actors(actors_to_export)

        task = unreal.AssetExportTask()
        task.set_editor_property("object", world)
        task.set_editor_property("filename", export_path)
        task.set_editor_property("automated", True)
        task.set_editor_property("prompt", False)
        task.set_editor_property("replace_identical", True)
        task.set_editor_property("selected", True)
        task.set_editor_property("exporter", exporter_cls())

        ok = unreal.Exporter.run_asset_export_task(task)
        if ok and os.path.exists(export_path):
            size_kb = os.path.getsize(export_path) / 1024
            unreal.log(
                f"  [v11] ABC 合并导出成功，共 {len(actors_to_export)} 个 Actor: "
                f"{export_path} ({size_kb:.1f} KB)"
            )
        else:
            unreal.log_error(f"  [v11] ABC 合并导出失败: {export_path}")
    finally:
        editor_actor_sub.set_selected_level_actors(prev_selected)

# ================================================================
