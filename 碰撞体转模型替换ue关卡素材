# ========== 配置 ==========
SUFFIX              = "_Convex"
AUTO_HULL_COUNT     = 4        # 凸包数量
AUTO_MAX_HULL_VERTS = 32       # 最大顶点数
AUTO_HULL_PRECISION = 100000   # 凸包精度（VHACD resolution）

SELECTED_ONLY    = False  # True → 只处理视口中当前选中的 Actor；False → 处理关卡所有 Actor
FORCE_RECREATE   = False  # True → 删除旧 _Convex 资产，按当前参数重建
FORCE_HULL_REGEN = False  # True → 删除旧凸包，按当前参数重新分解

# v10 新增
FLIP_NORMALS       = True  # True → 反转凸包网格法线（解决内表面问题）  # [v10 新增]
EXPORT_MESH_FORMAT = ""    # "" / "fbx" / "obj" → 额外导出简模文件      # [v10 新增]
EXPORT_MESH_DIR    = ""    # 留空使用系统 TEMP 目录                      # [v10 新增]
EXPORT_ABC         = False # True → 额外导出 ABC 单帧                    # [v10 新增]
EXPORT_ABC_DIR     = ""    # 留空使用系统 TEMP 目录                      # [v10 新增]

