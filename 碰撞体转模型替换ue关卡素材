def export_fbx_ascii(static_mesh, fbx_path):
    task = unreal.AssetExportTask()
    task.set_editor_property("object", static_mesh)
    task.set_editor_property("filename", fbx_path)
    task.set_editor_property("automated", True)
    task.set_editor_property("prompt", False)
    task.set_editor_property("replace_identical", True)
    options = unreal.FbxExportOption()
    options.set_editor_property("collision", True)
    options.set_editor_property("ascii", True)
    # ★ [Fix Scale] 关闭 LOD 导出，避免 LOD0 与高模缩放不一致引入尺寸偏差 ★
    try:
        options.set_editor_property("level_of_detail", False)
    except Exception:
        pass
    task.set_editor_property("options", options)
    task.set_editor_property("exporter", unreal.StaticMeshExporterFBX())
    ok = unreal.Exporter.run_asset_export_task(task)
    if ok and os.path.exists(fbx_path):
        unreal.log(f"  FBX 导出成功 ({os.path.getsize(fbx_path)/1024:.1f} KB)")
        return True
    unreal.log_error(f"  FBX 导出失败!")
    return False

# ================================================================
#  ★ 核心：掏空原始网格 + 精确去掉 UCX_ 前缀 → 只剩凸包
# ================================================================
# [Fix Bug1] 只替换节点声明行中引号内的 UCX_ 前缀，不动其他内容
_UCX_PATTERN = re.compile(r'("(?:Mesh|Model)::)UCX_')

def _strip_ucx_prefix(line):
    return _UCX_PATTERN.sub(r'\1', line)

# ----------------------------------------------------------------
#  [Fix Normals] 法线反转辅助函数
# ----------------------------------------------------------------
def _flip_poly_winding_data(data_str):
    """[Fix Normals] 反转 PolygonVertexIndex 数据中每个多边形的顶点绕序。
    FBX 以负数索引 (-n-1) 标记多边形结束，保持首顶点不变，颠倒其余顶点顺序。"""
    indices = []
    for x in data_str.split(','):
        x = x.strip()
        if x:
            indices.append(int(x))

    flipped = []
    current_poly = []
    for idx in indices:
        current_poly.append(idx)
        if idx < 0:  # 多边形结束标志
            actual_last = -idx - 1
            actual = current_poly[:-1] + [actual_last]
            if len(actual) >= 2:
                # 保持首顶点，颠倒其余顶点顺序
                flipped_actual = [actual[0]] + list(reversed(actual[1:]))
            else:
                flipped_actual = actual
            new_end = flipped_actual[-1]
            new_poly = flipped_actual[:-1] + [-new_end - 1]
            flipped.extend(new_poly)
            current_poly = []
    if current_poly:  # 不完整的多边形直接保留
        flipped.extend(current_poly)

    return ','.join(str(x) for x in flipped)

def _negate_normals_data(data_str):
    """[Fix Normals] 对法线数据的每个浮点数取反（乘以 -1）。"""
    parts = []
    for x in data_str.split(','):
        x = x.strip()
        if not x:
            continue
        try:
            v = float(x)
            if v == 0.0:
                parts.append(x)          # 零值保留原始写法
            elif x.startswith('-'):
                parts.append(x[1:])      # 去掉负号
            else:
                parts.append('-' + x)    # 加上负号
        except ValueError:
            parts.append(x)
    return ','.join(parts)

def _flip_normals_in_ucx_block(block_lines):
    """[Fix Normals] 遍历 UCX_ 几何块的各行，反转绕序并取反法线数组。"""
    result = []
    j = 0
    total_b = len(block_lines)

    while j < total_b:
        line = block_lines[j]
        stripped = line.strip()

        # [Fix Normals] 反转 PolygonVertexIndex 绕序
        if stripped.startswith('PolygonVertexIndex:'):
            result.append(line)
            j += 1
            depth = line.count('{') - line.count('}')
            # 若开括号不在同一行，继续查找
            while j < total_b and depth == 0 and '{' not in block_lines[j]:
                result.append(block_lines[j])
                j += 1
            if j < total_b and depth == 0:
                result.append(block_lines[j])
                depth = block_lines[j].count('{') - block_lines[j].count('}')
                j += 1
            # 处理数据行直到块结束
            while j < total_b and depth > 0:
                inner = block_lines[j]
                inner_s = inner.strip()
                if inner_s.startswith('a:'):
                    pfx_end = inner.index('a:') + 2
                    result.append(
                        inner[:pfx_end] + ' ' +
                        _flip_poly_winding_data(inner[pfx_end:].strip()) + '\n'
                    )
                else:
                    result.append(inner)
                depth += inner.count('{') - inner.count('}')
                j += 1
            continue

        # [Fix Normals] 取反法线向量（仅 Normals:，不含 NormalsW:）
        if stripped.startswith('Normals:') and not stripped.startswith('NormalsW:'):
            result.append(line)
            j += 1
            depth = line.count('{') - line.count('}')
            while j < total_b and depth == 0 and '{' not in block_lines[j]:
                result.append(block_lines[j])
                j += 1
            if j < total_b and depth == 0:
                result.append(block_lines[j])
                depth = block_lines[j].count('{') - block_lines[j].count('}')
                j += 1
            while j < total_b and depth > 0:
                inner = block_lines[j]
                inner_s = inner.strip()
                if inner_s.startswith('a:'):
                    pfx_end = inner.index('a:') + 2
                    result.append(
                        inner[:pfx_end] + ' ' +
                        _negate_normals_data(inner[pfx_end:].strip()) + '\n'
                    )
                else:
                    result.append(inner)
                depth += inner.count('{') - inner.count('}')
                j += 1
            continue

        result.append(line)
        j += 1

    return result

def build_convex_only_fbx(source_fbx, output_fbx):
    with open(source_fbx, 'r', encoding='utf-8', errors='ignore') as f:
        lines = f.readlines()
    total  = len(lines)
    output = []
    i      = 0
    replaced_count = 0

    while i < total:
        stripped = lines[i].strip()

        is_original_geometry = (
            stripped.startswith('Geometry:')
            and '"Mesh"' in stripped
            and 'UCX_' not in stripped
        )

        if is_original_geometry:
            header_line = lines[i]
            output.append(header_line)

            has_open_brace = '{' in header_line
            if not has_open_brace:
                i += 1
                while i < total and '{' not in lines[i]:
                    output.append(lines[i])
                    i += 1
                if i < total:
                    output.append(lines[i])
                    # [Fix Bug2] 从实际括号差值初始化深度
                    depth = lines[i].count('{') - lines[i].count('}')
                    i += 1
                else:
                    depth = 0
                while i < total and depth > 0:
                    depth += lines[i].count('{') - lines[i].count('}')
                    i += 1
            else:
                depth = header_line.count('{') - header_line.count('}')
                i += 1
                while i < total and depth > 0:
                    depth += lines[i].count('{') - lines[i].count('}')
                    i += 1

            # 写入微型占位几何体（3 个顶点，肉眼不可见）
            output.append('\tProperties70:  {\n')
            output.append('\t}\n')
            output.append('\tVertices: *9 {\n')
            output.append('\t\ta: 0,0,0,0.001,0,0,0,0.001,0\n')
            output.append('\t}\n')
            output.append('\tPolygonVertexIndex: *3 {\n')
            output.append('\t\ta: 0,1,-3\n')
            output.append('\t}\n')
            output.append('\tGeometryVersion: 124\n')
            output.append('}\n')
            replaced_count += 1
            unreal.log(f"  已掏空原始 Geometry 块 (第 {replaced_count} 个)")
            continue

        # [v10 新增][Fix Normals] 若开启法线反转，收集整个 UCX_ 几何块后统一处理
        is_ucx_geometry = (
            FLIP_NORMALS
            and stripped.startswith('Geometry:')
            and '"Mesh"' in stripped
            and 'UCX_' in stripped
        )

        if is_ucx_geometry:
            # 收集 UCX_ 块的全部行（首行已做 UCX_ 前缀去除）
            header_line = _strip_ucx_prefix(lines[i])
            block = [header_line]
            if '{' in header_line:
                depth = header_line.count('{') - header_line.count('}')
                i += 1
            else:
                i += 1
                while i < total and '{' not in lines[i]:
                    block.append(lines[i])
                    i += 1
                if i < total:
                    block.append(lines[i])
                    depth = lines[i].count('{') - lines[i].count('}')
                    i += 1
                else:
                    depth = 0
            while i < total and depth > 0:
                block.append(lines[i])
                depth += lines[i].count('{') - lines[i].count('}')
                i += 1
            output.extend(_flip_normals_in_ucx_block(block))
            continue

        # [Fix Bug1] 精确去掉节点声明行中的 UCX_ 前缀
        output.append(_strip_ucx_prefix(lines[i]))
        i += 1

    if replaced_count == 0:
        unreal.log_warning(f"  未找到非 UCX_ 的 Geometry 块")

    with open(output_fbx, 'w', encoding='utf-8') as f:
        f.writelines(output)
    unreal.log(
        f"  凸包 FBX 生成: 掏空 {replaced_count} 个原始 Geometry，"
        f"UCX_ 前缀精确替换完成，法线反转={'已启用' if FLIP_NORMALS else '已关闭'} "
        f"({os.path.getsize(output_fbx)/1024:.1f} KB)"
    )
    return True

# ================================================================
#  FBX 导入
# ================================================================
def import_fbx(fbx_path, dest_path, asset_name):
    def _safe_set_property(obj, prop_name, value):
        try:
            obj.set_editor_property(prop_name, value)
            return True
        except Exception as e:
            unreal.log_warning(f"  [Fix Scale] 属性 {prop_name} 设置失败（可能版本不支持）: {e}")
            return False

    task = unreal.AssetImportTask()
    task.set_editor_property("filename", fbx_path)
    task.set_editor_property("destination_path", dest_path)
    task.set_editor_property("destination_name", asset_name)
    task.set_editor_property("replace_existing", True)
    task.set_editor_property("automated", True)
    task.set_editor_property("save", True)

    options = unreal.FbxImportUI()
    options.set_editor_property("import_mesh", True)
    options.set_editor_property("import_materials", False)
    options.set_editor_property("import_textures", False)
    options.set_editor_property("import_as_skeletal", False)
    sm_data = options.get_editor_property("static_mesh_import_data")
    sm_data.set_editor_property("combine_meshes", True)
    sm_data.set_editor_property("auto_generate_collision", False)
    sm_data.set_editor_property("generate_lightmap_u_vs", False)
    # ★ [Fix Scale] 锁定缩放与坐标系，避免源 FBX 是从 UE 自己导出后再次导入时被二次转换 ★
    _safe_set_property(sm_data, "import_uniform_scale", 1.0)
    _safe_set_property(sm_data, "import_translation", unreal.Vector(0.0, 0.0, 0.0))
    _safe_set_property(sm_data, "import_rotation", unreal.Rotator(0.0, 0.0, 0.0))
    # 源 FBX 已是 UE 坐标系，关闭场景与单位转换，避免二次缩放/翻转
    _safe_set_property(sm_data, "convert_scene", False)
    _safe_set_property(sm_data, "convert_scene_unit", False)
    _safe_set_property(sm_data, "force_front_x_axis", False)
    # Build 阶段不再额外缩放
    _safe_set_property(sm_data, "build_scale3d", unreal.Vector(1.0, 1.0, 1.0))
    task.set_editor_property("options", options)

    unreal.AssetToolsHelpers.get_asset_tools().import_asset_tasks([task])

    expected_path = f"{dest_path}/{asset_name}"

    # [Fix Bug4] 优先从 imported_object_paths 取实际导入路径
    actual_path = None
    try:
        imported = task.get_editor_property("imported_object_paths")
        if imported and len(imported) > 0:
            actual_path = list(imported)[0]
            if '.' in actual_path:
                actual_path = actual_path.split('.')[0]
    except:
        pass

    if actual_path and unreal.EditorAssetLibrary.does_asset_exist(actual_path):
        if actual_path != expected_path:
            # [Fix Bug4] 路径不符（如多了 _1），自动重命名
            unreal.log_warning(
                f"  ⚠ 导入路径不符: 实际={actual_path}，期望={expected_path}，尝试重命名..."
            )
            if unreal.EditorAssetLibrary.rename_asset(actual_path, expected_path):
                unreal.log(f"  ✅ 重命名成功: {expected_path}")
            else:
                unreal.log_warning(f"  ⚠ 重命名失败，使用实际路径: {actual_path}")
        else:
            unreal.log(f"  ✅ 导入成功: {actual_path}")
        return True

    if unreal.EditorAssetLibrary.does_asset_exist(expected_path):
        unreal.log(f"  ✅ 导入成功: {expected_path}")
        return True

    unreal.log_warning(f"  ⚠ 导入结果未找到，请检查内容浏览器: {dest_path}")
    return False

# ================================================================
#  [v10 新增] 导出凸包简模为 FBX 或 OBJ 文件
# ================================================================
def export_convex_mesh_file(convex_mesh, fmt):
    """[v10 新增] 将凸包简模导出为 FBX 或 OBJ 文件。"""
    asset_name = get_asset_name(convex_mesh)
    export_dir = EXPORT_MESH_DIR if EXPORT_MESH_DIR else TEMP_DIR
    os.makedirs(export_dir, exist_ok=True)
    export_path = os.path.join(export_dir, f"{asset_name}.{fmt.lower()}")

    task = unreal.AssetExportTask()
    task.set_editor_property("object", convex_mesh)
    task.set_editor_property("filename", export_path)
    task.set_editor_property("automated", True)
    task.set_editor_property("prompt", False)
    task.set_editor_property("replace_identical", True)

    if fmt.lower() == "fbx":
        options = unreal.FbxExportOption()
        options.set_editor_property("collision", False)
        options.set_editor_property("ascii", False)  # 二进制 FBX
        task.set_editor_property("options", options)
        task.set_editor_property("exporter", unreal.StaticMeshExporterFBX())
    elif fmt.lower() == "obj":
        task.set_editor_property("exporter", unreal.StaticMeshExporterOBJ())
    else:
        unreal.log_warning(f"  [v10] 不支持的导出格式: {fmt}，请使用 fbx 或 obj（跳过导出）")
        return

    ok = unreal.Exporter.run_asset_export_task(task)
    if ok and os.path.exists(export_path):
        unreal.log(f"  [v10] 简模导出成功 ({fmt.upper()}): {export_path}")
    else:
        unreal.log_error(f"  [v10] 简模导出失败 ({fmt.upper()}): {export_path}")

# ================================================================
#  [v10 新增] 导出凸包简模为 ABC 单帧
# ================================================================
def export_convex_mesh_abc(convex_mesh):
    """[v10 新增] 将凸包简模导出为 Alembic (.abc) 单帧格式。"""
    asset_name = get_asset_name(convex_mesh)
    export_dir = EXPORT_ABC_DIR if EXPORT_ABC_DIR else TEMP_DIR
    os.makedirs(export_dir, exist_ok=True)
    export_path = os.path.join(export_dir, f"{asset_name}.abc")

    # 优先尝试 UE 内置 ABC Exporter 类
    exporter_cls = getattr(unreal, 'StaticMeshExporterABC', None)
    if exporter_cls is not None:
        task = unreal.AssetExportTask()
        task.set_editor_property("object", convex_mesh)
        task.set_editor_property("filename", export_path)
        task.set_editor_property("automated", True)
        task.set_editor_property("prompt", False)
        task.set_editor_property("replace_identical", True)
        task.set_editor_property("exporter", exporter_cls())
        ok = unreal.Exporter.run_asset_export_task(task)
        if ok and os.path.exists(export_path):
            unreal.log(f"  [v10] ABC 导出成功: {export_path}")
        else:
            unreal.log_error(f"  [v10] ABC 导出失败: {export_path}")
    else:
        # UE 5.5 Python 暂不直接支持 ABC 导出，提示手动操作
        unreal.log_warning(
            f"  [v10] UE Python 暂不直接支持 ABC 导出（请确认 Alembic 插件已在 UE 5.5 中启用），"
            f"请在 UE 内容浏览器中右键 → 导出 → Alembic: {asset_name}"
        )

# ================================================================
#  创建凸包简模
# ================================================================
def create_convex_mesh(static_mesh):
    name     = get_asset_name(static_mesh)
    pkg      = get_asset_package_path(static_mesh)
    new_name = name + SUFFIX
    unreal.log(f"\n  ── 创建凸包简模: {new_name} ──")

    need_restore, orig_complexity = (False, None)
    was_auto = False
    try:
        need_restore, orig_complexity = check_and_fix_collision_complexity(static_mesh)
        convex_count, was_auto = ensure_convex_collision(static_mesh)
        if convex_count <= 0:
            return None

        fbx_src = os.path.join(TEMP_DIR, f"{name}_export.fbx")
        if not export_fbx_ascii(static_mesh, fbx_src):
            return None

        fbx_out = os.path.join(TEMP_DIR, f"{new_name}.fbx")
        if not build_convex_only_fbx(fbx_src, fbx_out):
            return None

        if import_fbx(fbx_out, pkg, new_name):
            return f"{pkg}/{new_name}"
        return None
    finally:
        if need_restore:
            restore_collision_complexity(static_mesh, orig_complexity)
        if was_auto:
            sm_sub = unreal.get_editor_subsystem(unreal.StaticMeshEditorSubsystem)
            sm_sub.remove_collisions(static_mesh)
        unreal.log(f"  ✓ 原模型未保存修改")

# ================================================================
#  获取或创建凸包简模
# ================================================================
def get_or_create_convex_mesh(static_mesh):
    name        = get_asset_name(static_mesh)
    pkg         = get_asset_package_path(static_mesh)
    convex_path = f"{pkg}/{name}{SUFFIX}"

    if unreal.EditorAssetLibrary.does_asset_exist(convex_path):
        if not FORCE_RECREATE:
            unreal.log(f"  ✓ 已有凸包简模（FORCE_RECREATE=False，直接使用）: {convex_path}")
            mesh = unreal.EditorAssetLibrary.load_asset(convex_path)
            if mesh and isinstance(mesh, unreal.StaticMesh):
                _run_convex_exports(mesh)  # [v10 新增] 按配置导出
                return (mesh, False)
        else:
            unreal.log(f"  ↺ FORCE_RECREATE=True，删除旧资产并重建: {convex_path}")
            unreal.EditorAssetLibrary.delete_asset(convex_path)

    result_path = create_convex_mesh(static_mesh)
    if result_path:
        for try_path in [result_path, convex_path]:
            mesh = unreal.EditorAssetLibrary.load_asset(try_path)
            if mesh and isinstance(mesh, unreal.StaticMesh):
                _run_convex_exports(mesh)  # [v10 新增] 按配置导出
                return (mesh, True)
    return (None, False)

def _run_convex_exports(convex_mesh):
    """[v10 新增] 根据配置将凸包简模导出为 FBX/OBJ 和/或 ABC。"""
    if EXPORT_MESH_FORMAT:
        export_convex_mesh_file(convex_mesh, EXPORT_MESH_FORMAT)
    if EXPORT_ABC:
        export_convex_mesh_abc(convex_mesh)

# ================================================================
#  关卡扫描 & 替换
# ================================================================
def find_actors_using_mesh(static_mesh, actor_pool=None):
    """
    在 actor_pool（或全部关卡 Actor）中找所有使用指定网格的 Actor + Component。
    actor_pool: 传入已缓存的 Actor 列表，避免重复调用 get_all_level_actors
    """
    source_path = get_full_asset_path(static_mesh)
    results     = []

    if actor_pool is None:
        editor_sub = unreal.get_editor_subsystem(unreal.EditorActorSubsystem)
        actor_pool = editor_sub.get_all_level_actors()

    for actor in actor_pool:
        components = actor.get_components_by_class(unreal.StaticMeshComponent)
        for comp in components:
            mesh = comp.static_mesh
            if mesh is None:
                continue
            if get_full_asset_path(mesh) == source_path:
                results.append((actor, comp))
    return results

def replace_actor_mesh(actor, component, new_mesh):
    actor_name = ""
    try:
        actor_name = unreal.SystemLibrary.get_object_name(actor)
    except:
        actor_name = str(actor.get_fname())
    override_mats = []
    num_mats = component.get_num_materials()
    for idx in range(num_mats):
        override_mats.append(component.get_material(idx))
    component.set_static_mesh(new_mesh)
    for idx, mat in enumerate(override_mats):
        if mat is not None and idx < component.get_num_materials():
            component.set_material(idx, mat)
    return actor_name

# ================================================================
#  主流程
# ================================================================
def process_one_source_mesh(static_mesh, actor_pool):
    name = get_asset_name(static_mesh)
    pkg  = get_asset_package_path(static_mesh)
    unreal.log(f"\n{'═'*60}")
    unreal.log(f"  源模型: {name}")
    unreal.log(f"  路径:   {pkg}")
    # ★ [Fix Scale] 诊断：打印源模型包围盒尺寸，方便定位缩放异常 ★
    try:
        src_bounds = static_mesh.get_bounds()
        src_size = src_bounds.box_extent * 2.0
        unreal.log(f"  [诊断] 源包围盒尺寸 (cm): X={src_size.x:.2f}, Y={src_size.y:.2f}, Z={src_size.z:.2f}")
    except Exception as e:
        unreal.log_warning(f"  [诊断] 读取源包围盒失败: {e}")
    unreal.log(f"{'═'*60}")

    # 1. 获取/创建凸包简模
    convex_mesh, was_created = get_or_create_convex_mesh(static_mesh)
    if convex_mesh is None:
        unreal.log_error(f"  ❌ 凸包简模创建失败")
        return (0, 0)
    status = "新创建" if was_created else "已有"
    unreal.log(f"  ✓ 凸包简模 ({status}): {get_asset_name(convex_mesh)}")
    # ★ [Fix Scale] 诊断：打印简模包围盒尺寸并与源对比 ★
    try:
        cv_bounds = convex_mesh.get_bounds()
        cv_size = cv_bounds.box_extent * 2.0
        unreal.log(f"  [诊断] 简模包围盒尺寸 (cm): X={cv_size.x:.2f}, Y={cv_size.y:.2f}, Z={cv_size.z:.2f}")
        # 若任一轴 < 源尺寸 80% 则警告
        try:
            ratio_x = cv_size.x / src_size.x if src_size.x > 0.001 else 1.0
            ratio_y = cv_size.y / src_size.y if src_size.y > 0.001 else 1.0
            ratio_z = cv_size.z / src_size.z if src_size.z > 0.001 else 1.0
            min_ratio = min(ratio_x, ratio_y, ratio_z)
            if min_ratio < 0.8:
                unreal.log_warning(
                    f"  ⚠ [Fix Scale] 简模尺寸明显小于源 (最小轴比 {min_ratio:.2f})！"
                    f" 比例 X={ratio_x:.2f}, Y={ratio_y:.2f}, Z={ratio_z:.2f}"
                )
        except NameError:
            pass
    except Exception as e:
        unreal.log_warning(f"  [诊断] 读取简模包围盒失败: {e}")

    # 2. 在缓存的 actor_pool 中找目标 Actor（避免重复扫描关卡）
    actors = find_actors_using_mesh(static_mesh, actor_pool)
    if not actors:
        unreal.log(f"  关卡中没有使用 {name} 的 Actor")
        return (0, 0)
    unreal.log(f"  找到 {len(actors)} 个 Actor/组件")

    # 3. 替换（支持 Ctrl+Z 撤销）
    replaced = 0
    failed   = 0
    with unreal.ScopedEditorTransaction("Replace With Convex") as trans:
        for actor, comp in actors:
            try:
                aname = replace_actor_mesh(actor, comp, convex_mesh)
                replaced += 1
                unreal.log(f"    ✓ {aname}")
            except Exception as e:
                failed += 1
                unreal.log_error(f"    ✗ {e}")
    unreal.log(f"  替换: {replaced} 成功, {failed} 失败")
    return (replaced, failed)


def main():
    unreal.log("╔══════════════════════════════════════════════════════╗")
    unreal.log("║  凸包替换工具 v11.1 (UE 5.5) [Fix Scale]            ║")
    unreal.log("║  ★ 自动扫描场景 Actor → 收集唯一网格 → 创建并替换   ║")
    unreal.log("║  Ctrl+Z 撤销 | 保留 Transform/材质                  ║")
    unreal.log("╚══════════════════════════════════════════════════════╝")
    unreal.log("[v11.1 Fix Scale] 修复部分场景凸包导入后变小的问题：锁定 import_uniform_scale=1、convert_scene=False、convert_scene_unit=False，关闭 LOD 导出，新增包围盒诊断日志")
    unreal.log(
        f"[v10 配置] HULL_COUNT={AUTO_HULL_COUNT}, MAX_VERTS={AUTO_MAX_HULL_VERTS}, "
        f"PRECISION={AUTO_HULL_PRECISION} | "
        f"SELECTED_ONLY={SELECTED_ONLY}, "
        f"FORCE_RECREATE={FORCE_RECREATE}, FORCE_HULL_REGEN={FORCE_HULL_REGEN}"
    )
    unreal.log(
        f"[v10 新增] FLIP_NORMALS={FLIP_NORMALS} | "
        f"EXPORT_MESH_FORMAT={EXPORT_MESH_FORMAT!r}, EXPORT_MESH_DIR={EXPORT_MESH_DIR!r} | "
        f"EXPORT_ABC={EXPORT_ABC}, EXPORT_ABC_DIR={EXPORT_ABC_DIR!r}"
    )

    # 缓存全部 Actor，供后续各 mesh 复用，避免重复调用 get_all_level_actors
    editor_sub = unreal.get_editor_subsystem(unreal.EditorActorSubsystem)
    if SELECTED_ONLY:
        actor_pool = list(editor_sub.get_selected_level_actors())
    else:
        actor_pool = list(editor_sub.get_all_level_actors())

    # 从 actor_pool 收集唯一源网格
    seen_paths  = set()
    meshes      = []
    skip_convex = 0
    for actor in actor_pool:
        for comp in actor.get_components_by_class(unreal.StaticMeshComponent):
            mesh = comp.static_mesh
            if mesh is None:
                continue
            name = get_asset_name(mesh)
            if name.endswith(SUFFIX):
                skip_convex += 1
                continue
            path = get_full_asset_path(mesh)
            if path not in seen_paths:
                seen_paths.add(path)
                meshes.append(mesh)

    unreal.log(
        f"  扫描完成: {len(actor_pool)} 个 Actor，"
        f"{len(meshes)} 个唯一源网格，跳过 {skip_convex} 个已有简模组件"
    )

    if not meshes:
        unreal.log_warning("⚠ 关卡中未找到任何需要处理的 StaticMesh，已退出。")
        return

    total_replaced = 0
    total_failed   = 0
    with unreal.ScopedSlowTask(len(meshes), "处理中...") as slow_task:
        slow_task.make_dialog(True)
        for mesh in meshes:
            if slow_task.should_cancel():
                unreal.log("  ⚠ 用户取消操作")
                break
            slow_task.enter_progress_frame(1, f"处理: {get_asset_name(mesh)}")
            r, f = process_one_source_mesh(mesh, actor_pool)
            total_replaced += r
            total_failed   += f

    unreal.log(f"\n{'═'*60}")
    unreal.log(f"  完成! 替换: {total_replaced} 成功, {total_failed} 失败")
    unreal.log(f"  Ctrl+Z 可撤销全部替换")
    unreal.log(f"{'═'*60}")


main()
