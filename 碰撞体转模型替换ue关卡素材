# ================================================================
#  ★ 核心：掏空原始网格 + 精确去掉 UCX_ 前缀 → 只剩凸包
# ================================================================
# [Fix Bug1] 只替换节点声明行中引号内的 UCX_ 前缀，不动其他内容
_UCX_PATTERN = re.compile(r'("(?:Mesh|Model)::)UCX_')

def _strip_ucx_prefix(line):
    return _UCX_PATTERN.sub(r'\1', line)

# ----------------------------------------------------------------
#  [Fix Normals] 法线反转辅助函数
# ----------------------------------------------------------------
def _flip_poly_winding_data(data_str):
    """[Fix Normals] 反转 PolygonVertexIndex 数据中每个多边形的顶点绕序。
    FBX 以负数索引 (-n-1) 标记多边形结束，保持首顶点不变，颠倒其余顶点顺序。"""
    indices = []
    for x in data_str.split(','):
        x = x.strip()
        if x:
            indices.append(int(x))

    flipped = []
    current_poly = []
    for idx in indices:
        current_poly.append(idx)
        if idx < 0:  # 多边形结束标志
            actual_last = -idx - 1
            actual = current_poly[:-1] + [actual_last]
            if len(actual) >= 2:
                # 保持首顶点，颠倒其余顶点顺序
                flipped_actual = [actual[0]] + list(reversed(actual[1:]))
            else:
                flipped_actual = actual
            new_end = flipped_actual[-1]
            new_poly = flipped_actual[:-1] + [-new_end - 1]
            flipped.extend(new_poly)
            current_poly = []
    if current_poly:  # 不完整的多边形直接保留
        flipped.extend(current_poly)

    return ','.join(str(x) for x in flipped)

def _negate_normals_data(data_str):
    """[Fix Normals] 对法线数据的每个浮点数取反（乘以 -1）。"""
    parts = []
    for x in data_str.split(','):
        x = x.strip()
        if not x:
            continue
        try:
            v = float(x)
            if v == 0.0:
                parts.append(x)          # 零值保留原始写法
            elif x.startswith('-'):
                parts.append(x[1:])      # 去掉负号
            else:
                parts.append('-' + x)    # 加上负号
        except ValueError:
            parts.append(x)
    return ','.join(parts)

def _flip_normals_in_ucx_block(block_lines):
    """[Fix Normals] 遍历 UCX_ 几何块的各行，反转绕序并取反法线数组。"""
    result = []
    j = 0
    total_b = len(block_lines)

    while j < total_b:
        line = block_lines[j]
        stripped = line.strip()

        # [Fix Normals] 反转 PolygonVertexIndex 绕序
        if stripped.startswith('PolygonVertexIndex:'):
            result.append(line)
            j += 1
            depth = line.count('{') - line.count('}')
            # 若开括号不在同一行，继续查找
            while j < total_b and depth == 0 and '{' not in block_lines[j]:
                result.append(block_lines[j])
                j += 1
            if j < total_b and depth == 0:
                result.append(block_lines[j])
                depth = block_lines[j].count('{') - block_lines[j].count('}')
                j += 1
            # 处理数据行直到块结束
            while j < total_b and depth > 0:
                inner = block_lines[j]
                inner_s = inner.strip()
                if inner_s.startswith('a:'):
                    pfx_end = inner.index('a:') + 2
                    result.append(
                        inner[:pfx_end] + ' ' +
                        _flip_poly_winding_data(inner[pfx_end:].strip()) + '\n'
                    )
                else:
                    result.append(inner)
                depth += inner.count('{') - inner.count('}')
                j += 1
            continue

        # [Fix Normals] 取反法线向量（仅 Normals:，不含 NormalsW:）
        if stripped.startswith('Normals:') and not stripped.startswith('NormalsW:'):
            result.append(line)
            j += 1
            depth = line.count('{') - line.count('}')
            while j < total_b and depth == 0 and '{' not in block_lines[j]:
                result.append(block_lines[j])
                j += 1
            if j < total_b and depth == 0:
                result.append(block_lines[j])
                depth = block_lines[j].count('{') - block_lines[j].count('}')
                j += 1
            while j < total_b and depth > 0:
                inner = block_lines[j]
                inner_s = inner.strip()
                if inner_s.startswith('a:'):
                    pfx_end = inner.index('a:') + 2
                    result.append(
                        inner[:pfx_end] + ' ' +
                        _negate_normals_data(inner[pfx_end:].strip()) + '\n'
                    )
                else:
                    result.append(inner)
                depth += inner.count('{') - inner.count('}')
                j += 1
            continue

        result.append(line)
        j += 1

    return result

def build_convex_only_fbx(source_fbx, output_fbx):
    with open(source_fbx, 'r', encoding='utf-8', errors='ignore') as f:
        lines = f.readlines()
    total  = len(lines)
    output = []
    i      = 0
    replaced_count = 0

    while i < total:
        stripped = lines[i].strip()

        is_original_geometry = (
            stripped.startswith('Geometry:')
            and '"Mesh"' in stripped
            and 'UCX_' not in stripped
        )

        if is_original_geometry:
            header_line = lines[i]
            output.append(header_line)

            has_open_brace = '{' in header_line
            if not has_open_brace:
                i += 1
                while i < total and '{' not in lines[i]:
                    output.append(lines[i])
                    i += 1
                if i < total:
                    output.append(lines[i])
                    # [Fix Bug2] 从实际括号差值初始化深度
                    depth = lines[i].count('{') - lines[i].count('}')
                    i += 1
                else:
                    depth = 0
                while i < total and depth > 0:
                    depth += lines[i].count('{') - lines[i].count('}')
                    i += 1
            else:
                depth = header_line.count('{') - header_line.count('}')
                i += 1
                while i < total and depth > 0:
                    depth += lines[i].count('{') - lines[i].count('}')
                    i += 1

            # 写入微型占位几何体（3 个顶点，肉眼不可见）
            output.append('\tProperties70:  {\n')
            output.append('\t}\n')
            output.append('\tVertices: *9 {\n')
            output.append('\t\ta: 0,0,0,0.001,0,0,0,0.001,0\n')
            output.append('\t}\n')
            output.append('\tPolygonVertexIndex: *3 {\n')
            output.append('\t\ta: 0,1,-3\n')
            output.append('\t}\n')
            output.append('\tGeometryVersion: 124\n')
            output.append('}\n')
            replaced_count += 1
            unreal.log(f"  已掏空原始 Geometry 块 (第 {replaced_count} 个)")
            continue

        # [v10 新增][Fix Normals] 若开启法线反转，收集整个 UCX_ 几何块后统一处理
        is_ucx_geometry = (
            FLIP_NORMALS
            and stripped.startswith('Geometry:')
            and '"Mesh"' in stripped
            and 'UCX_' in stripped
        )

        if is_ucx_geometry:
            # 收集 UCX_ 块的全部行（首行已做 UCX_ 前缀去除）
            header_line = _strip_ucx_prefix(lines[i])
            block = [header_line]
            if '{' in header_line:
                depth = header_line.count('{') - header_line.count('}')
                i += 1
            else:
                i += 1
                while i < total and '{' not in lines[i]:
                    block.append(lines[i])
                    i += 1
                if i < total:
                    block.append(lines[i])
                    depth = lines[i].count('{') - lines[i].count('}')
                    i += 1
                else:
                    depth = 0
            while i < total and depth > 0:
                block.append(lines[i])
                depth += lines[i].count('{') - lines[i].count('}')
                i += 1
            output.extend(_flip_normals_in_ucx_block(block))
            continue

        # [Fix Bug1] 精确去掉节点声明行中的 UCX_ 前缀
        output.append(_strip_ucx_prefix(lines[i]))
        i += 1

    if replaced_count == 0:
        unreal.log_warning(f"  未找到非 UCX_ 的 Geometry 块")

    with open(output_fbx, 'w', encoding='utf-8') as f:
        f.writelines(output)
    unreal.log(
        f"  凸包 FBX 生成: 掏空 {replaced_count} 个原始 Geometry，"
        f"UCX_ 前缀精确替换完成，法线反转={'已启用' if FLIP_NORMALS else '已关闭'} "
        f"({os.path.getsize(output_fbx)/1024:.1f} KB)"
    )
    return True

# ================================================================
#  FBX 导入
# ================================================================
def import_fbx(fbx_path, dest_path, asset_name):
    task = unreal.AssetImportTask()
    task.set_editor_property("filename", fbx_path)
    task.set_editor_property("destination_path", dest_path)
    task.set_editor_property("destination_name", asset_name)
    task.set_editor_property("replace_existing", True)
    task.set_editor_property("automated", True)
    task.set_editor_property("save", True)

    options = unreal.FbxImportUI()
    options.set_editor_property("import_mesh", True)
    options.set_editor_property("import_materials", False)
    options.set_editor_property("import_textures", False)
    options.set_editor_property("import_as_skeletal", False)
    sm_data = options.get_editor_property("static_mesh_import_data")
    sm_data.set_editor_property("combine_meshes", True)
    sm_data.set_editor_property("auto_generate_collision", False)
    sm_data.set_editor_property("generate_lightmap_u_vs", False)
    task.set_editor_property("options", options)

    unreal.AssetToolsHelpers.get_asset_tools().import_asset_tasks([task])

    expected_path = f"{dest_path}/{asset_name}"

    # [Fix Bug4] 优先从 imported_object_paths 取实际导入路径
    actual_path = None
    try:
        imported = task.get_editor_property("imported_object_paths")
        if imported and len(imported) > 0:
            actual_path = list(imported)[0]
            if '.' in actual_path:
                actual_path = actual_path.split('.')[0]
    except:
        pass

    if actual_path and unreal.EditorAssetLibrary.does_asset_exist(actual_path):
        if actual_path != expected_path:
            # [Fix Bug4] 路径不符（如多了 _1），自动重命名
            unreal.log_warning(
                f"  ⚠ 导入路径不符: 实际={actual_path}，期望={expected_path}，尝试重命名..."
            )
            if unreal.EditorAssetLibrary.rename_asset(actual_path, expected_path):
                unreal.log(f"  ✅ 重命名成功: {expected_path}")
            else:
                unreal.log_warning(f"  ⚠ 重命名失败，使用实际路径: {actual_path}")
        else:
            unreal.log(f"  ✅ 导入成功: {actual_path}")
        return True

    if unreal.EditorAssetLibrary.does_asset_exist(expected_path):
        unreal.log(f"  ✅ 导入成功: {expected_path}")
        return True

    unreal.log_warning(f"  ⚠ 导入结果未找到，请检查内容浏览器: {dest_path}")
    return False

# ================================================================
#  [v10 新增 / v11 Deprecated] 单文件单模型导出 - 已弃用，由合并导出替代
# ================================================================
def export_convex_mesh_file(convex_mesh, fmt):
    """[Deprecated v11] 将单个凸包简模导出为 FBX 或 OBJ 文件。
    v11 起不再被调用，合并导出请使用 export_merged_convex()。"""
    asset_name = get_asset_name(convex_mesh)
    export_dir = EXPORT_MESH_DIR if EXPORT_MESH_DIR else TEMP_DIR
    os.makedirs(export_dir, exist_ok=True)
    export_path = os.path.join(export_dir, f"{asset_name}.{fmt.lower()}")

    task = unreal.AssetExportTask()
    task.set_editor_property("object", convex_mesh)
    task.set_editor_property("filename", export_path)
    task.set_editor_property("automated", True)
    task.set_editor_property("prompt", False)
    task.set_editor_property("replace_identical", True)

    if fmt.lower() == "fbx":
        options = unreal.FbxExportOption()
        options.set_editor_property("collision", False)
        options.set_editor_property("ascii", False)
        task.set_editor_property("options", options)
        task.set_editor_property("exporter", unreal.StaticMeshExporterFBX())
    elif fmt.lower() == "obj":
        task.set_editor_property("exporter", unreal.StaticMeshExporterOBJ())
    else:
        unreal.log_warning(f"  [Deprecated] 不支持的导出格式: {fmt}，请使用 fbx 或 obj（跳过导出）")
        return

    ok = unreal.Exporter.run_asset_export_task(task)
    if ok and os.path.exists(export_path):
        unreal.log(f"  [Deprecated] 简模导出成功 ({fmt.upper()}): {export_path}")
    else:
        unreal.log_error(f"  [Deprecated] 简模导出失败 ({fmt.upper()}): {export_path}")

